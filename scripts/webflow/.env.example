# Poswiadczenia kanalu publikacji Webflow (blog MindSync).
# Skopiuj do scripts/webflow/.env i uzupelnij. NIGDY nie commituj .env.
#
# Token: Webflow -> Site Settings (Mind Sync) -> Apps & Integrations -> API access
#        -> Generate API token. Przy generowaniu ZAZNACZ zakresy (scopes):
#        CMS = Read and write, Assets = Read and write, Sites = Read-only.
#        Token bez zakresow daje HTTP 403 "missing_scopes" na kazdym wywolaniu
#        (przerobione 2026-08-25). Zakresow istniejacego tokena nie da sie edytowac
#        - wygeneruj nowy i podmien wartosc ponizej.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=676ed8d44b863915ae191f41
WEBFLOW_COLLECTION_ID=67cb62e9d0afa32a03eae3f1
