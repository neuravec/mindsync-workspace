# Skopiuj ten plik jako scripts/revenue/.env i uzupełnij wartości. Plik .env NIGDY nie trafia do repo.

# ---------- App Store Connect (asc_reports.py) ----------
# Issuer ID: App Store Connect -> Users and Access -> Integrations -> App Store Connect API (nad listą kluczy)
ASC_ISSUER_ID=
# Key ID: kolumna "Key ID" przy wygenerowanym kluczu zespołowym (rola Finance lub Sales)
ASC_KEY_ID=
# Ścieżka do pliku .p8 (pobieranego tylko raz). Puste = scripts/revenue/AuthKey_<KEY_ID>.p8
ASC_PRIVATE_KEY_PATH=
# Vendor Number: Payments and Financial Reports (lewy górny róg, numer zaczyna się zwykle od 8)
ASC_VENDOR_NUMBER=

# ---------- Google Play (play_reports.py) ----------
# Ścieżka do klucza JSON konta serwisowego. Puste = scripts/revenue/play-service-account.json
PLAY_SERVICE_ACCOUNT_JSON=
# Numer konta dewelopera Play: liczba z adresu play.google.com/console/u/0/developers/<TEN_NUMER>/...
PLAY_DEVELOPER_ID=
# Opcjonalnie: dokładny bucket z Play Console -> Download reports -> "Copy Cloud Storage URI" (np. gs://pubsite_prod_rev_...)
# Ma pierwszeństwo przed PLAY_DEVELOPER_ID.
PLAY_BUCKET=
