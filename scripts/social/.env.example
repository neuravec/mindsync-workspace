# Poswiadczenia publikatora Instagrama MindSync (scripts/social/ig-publish.py, ig-token.py).
# Skopiuj do scripts/social/.env i uzupelnij. NIGDY nie commituj .env (jest w .gitignore).
# Plik .env jest zrodlem prawdy; zmienne srodowiskowe uzupelniaja tylko brakujace klucze.

# --- Instagram API with Instagram Login (graph.instagram.com) ---
# Token long-lived (60 dni) z aplikacji Meta: Instagram > API setup with Instagram login >
# Generate token (konto MindSync dodane jako Instagram Tester). Uprawnienia:
# instagram_business_basic + instagram_business_content_publish.
IG_ACCESS_TOKEN=
# user_id konta (sprawdz: python scripts/social/ig-token.py whoami)
IG_USER_ID=
IG_GRAPH_VERSION=v23.0
# ISO UTC, np. 2026-12-01T12:00:00+00:00. Ustawia ig-token.py refresh; po recznym
# wygenerowaniu tokenu wpisz date wygasniecia (dzis + 60 dni) albo uruchom refresh po 24 h.
IG_TOKEN_EXPIRES_AT=
IG_TOKEN_REFRESHED_AT=
# alt_text: wspierany dla single i elementow karuzeli (Meta, 2025-03-24), nie dla story.
# 0 = nie wysylaj (gdyby API zaczelo go odrzucac).
IG_SEND_ALT_TEXT=1
IG_POLL_INTERVAL_SEC=5
IG_POLL_MAX_SEC=300
# Rolki (typ reel): wideo przetwarza sie minutami, osobny, dluzszy polling kontenera.
IG_VIDEO_POLL_INTERVAL_SEC=15
IG_VIDEO_POLL_MAX_SEC=900

# --- Hosting mediow (Meta pobiera JPEG z publicznego URL-a w chwili publikacji) ---
# cloudinary | webflow
SOCIAL_MEDIA_HOST=
# Host dla wideo rolek (.mp4). Pusty = SOCIAL_MEDIA_HOST. Webflow Assets API wideo NIE przyjmuje,
# wiec przy SOCIAL_MEDIA_HOST=webflow rolki wymagaja SOCIAL_VIDEO_HOST=cloudinary.
SOCIAL_VIDEO_HOST=

# Cloudinary: upload podpisany (API_KEY + API_SECRET) albo unsigned (UPLOAD_PRESET).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=mindsync-social

# Webflow: token i site id sa czytane z ISTNIEJACEGO scripts/webflow/.env
# (WEBFLOW_API_TOKEN, WEBFLOW_SITE_ID). Nie kopiuj ich tutaj; wpisz tylko, jesli chcesz
# osobny token dla social (wymaga zakresu Assets = Read and write).
# WEBFLOW_API_TOKEN=
# WEBFLOW_SITE_ID=
