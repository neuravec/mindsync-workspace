# Klucz ClickUp do scripts/clickup.py (ticket-agent). Wartość: menedżer haseł albo własny token z ClickUp, Settings, Apps.
CLICKUP_API=

# Reddit MCP (serwer "reddit" w .mcp.json). Claude Code czyta te wartości ze zmiennych środowiskowych systemu, nie z tego pliku.
# Bez CLIENT_ID i SECRET serwer działa w trybie RSS: tylko browse_subreddit i get_top_posts.
# Nowe klucze OAuth wydaje Reddit Developer Support (self-service zamknięty w listopadzie 2025).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Login i hasło konta Reddit są potrzebne tylko do publikowania, odpowiadania i edycji.
REDDIT_USERNAME=
REDDIT_PASSWORD=
